# Copy to .env for local runs. In CI these are GitHub repository secrets
# (Settings -> Secrets and variables -> Actions).

# REQUIRED. Internal integration secret from https://www.notion.so/my-integrations
# The integration must also be shared with the target page/database, or the API
# returns 404 for a page that plainly exists.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED after the database exists. Get it by running:
#   python -m radar.main --create-database
NOTION_DATABASE_ID=

# Only needed for --create-database: the page the database is created under.
NOTION_PARENT_PAGE_ID=

# OPTIONAL but strongly recommended. Without it, relevance falls back to keyword
# rules alone and every row gets the same generic resume keywords.
ANTHROPIC_API_KEY=

# OPTIONAL. Without it the Recruiter Contact column stays empty.
# NOTE: connecting the Apollo *connector* on claude.ai does NOT satisfy this --
# a connector authenticates a chat session, not an unattended cron job.
APOLLO_API_KEY=
